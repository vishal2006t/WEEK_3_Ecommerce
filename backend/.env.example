# DevilCart Environment Configuration Example (Backend)
# Copy this file to backend/.env and fill in your details

# Server Configuration
PORT=5000
NODE_ENV=development

# CORS Configuration (Set to your deployed Vercel frontend URL on Render)
# Example: FRONTEND_URL=https://your-devilcart-store.vercel.app
FRONTEND_URL=https://YOUR-VERCEL-DOMAIN.vercel.app

# MySQL Database Configuration (Local / Cloud MySQL like Aiven, TiDB, Clever Cloud, PlanetScale, AWS RDS)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=ecommerce_db

# Optional: Set to true if connecting to cloud MySQL with SSL requirements
DB_SSL=false
